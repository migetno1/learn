\pard\qc\keepn\sb0\sa280\f0\fs38\b\cf1 Technologies in General Practice \u8212? presenter reminder guide\b0\par
\pard\li360\ri360\sb40\sa90\f0\fs20\i\cf4 {\b Target:} about 35 minutes; acceptable range 30\u8211?40 minutes.\i0\par
\pard\li360\ri360\sb40\sa90\f0\fs20\i\cf4 {\b Evidence:} current as at 12 July 2026, Australia.\i0\par
\pard\li360\ri360\sb40\sa90\f0\fs20\i\cf4 {\b Tone:} practical discussion with GP colleagues; named products are examples, not endorsements.\i0\par
\pard\keepn\sb240\sa150\f0\fs29\b\cf1 Before you start\b0\par
\pard\li720\fi-300\tx720\sa65\f0\fs21\cf1\bullet\tab Enter fullscreen; use Arrow keys, Page Up/Down or Space to move.\par
\pard\li720\fi-300\tx720\sa65\f0\fs21\cf1\bullet\tab Keep a glass of water nearby and this guide visible on a second screen or printed.\par
\pard\li720\fi-300\tx720\sa65\f0\fs21\cf1\bullet\tab Start a timer. Aim to reach slide 7 at about 16 minutes and slide 12 at about 29 minutes.\par
\pard\li720\fi-300\tx720\sa65\f0\fs21\cf1\bullet\tab If running late: shorten practice examples, then omit slide 13. Do not rush the safety boundaries.\par
\pard\li720\fi-300\tx720\sa65\f0\fs21\cf1\bullet\tab If asked for legal advice: recording and consent requirements vary; follow local policy and obtain MDO/legal advice.\par
\pard\li720\fi-300\tx720\sa65\f0\fs21\cf1\bullet\tab Never use real patient information in a live AI demonstration.\par
\pard\keepn\sb240\sa150\f0\fs29\b\cf1 Running clock\b0\par
\pard\keepn\sb80\sa80\tx1500\tx2900\tx8500\f0\fs19\b\cf1 Clock\tab Slide\tab Main job\b0\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:00\tab 1\tab Set patient-centred test\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:02\tab 2\tab Introduce Michael\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:04\tab 3\tab Pre-consultation history\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:07\tab 4\tab Ambient scribe\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:11\tab 5\tab Evidence-linked prompts\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:14\tab 6\tab Generative second check\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:17\tab 7\tab Evidence retrieval\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:20\tab 8\tab Patient-information drafting\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:23\tab 9\tab Reminders, recalls and outreach\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:26\tab 10\tab Remote monitoring\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:29\tab 11\tab Treatment optimisation\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:32\tab 12\tab Narrow retinal image AI\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:35\tab 13\tab Optional clinician learning\par
\pard\sa70\tx1500\tx2900\tx8500\f0\fs19\cf1 0:38\tab 14\tab Close; finish by 0:40\par
